# URL pública do site, usada em canonical, Open Graph, sitemap e dados estruturados.
# Só o domínio, sem caminho. Ex.: https://seu-dominio.dev
NEXT_PUBLIC_SITE_URL=

# Autoriza a indexação por buscadores: só o valor "allow" libera, e exige
# NEXT_PUBLIC_SITE_URL com https fora de localhost. Deixe vazio em local e em previews.
SITE_INDEXING=
